#!/bin/sh
set --
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_ref:$remote_ref" in
    '(delete):'*) ;;
    *:refs/heads/*) set -- "$@" "$remote_oid..$local_oid" ;;
  esac
done
[ "$#" -gt 0 ] || exit 0
unset $(git rev-parse --local-env-vars)
exec bun run check --changed "$@"
