{
  "name": "agentic-game-factory",
  "version": "1.0.0",
  "private": true,
  "description": "A kit for building a small 2D game with Phaser, TypeScript and a coding agent.",
  "license": "MIT",
  "repository": "https://github.com/hackersandwizards/agentic-game-factory",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.4.5",
    "npm": "please-use-bun"
  },
  "scripts": {
    "preinstall": "node -e \"if (!/^bun\\//.test(process.env.npm_config_user_agent ?? 'bun/')) throw new Error('This kit installs with bun: run bun install')\"",
    "dev": "bun --bun vite",
    "build": "bun --no-env-file scripts/tasks.mjs build",
    "format": "bun --bun prettier --write .",
    "check": "bun --no-env-file scripts/tasks.mjs check",
    "prepare": "bun --no-env-file scripts/install-hooks.mjs",
    "check:staged": "bun --no-env-file scripts/staged.mjs",
    "lint": "bun --no-env-file scripts/tasks.mjs lint",
    "test": "vitest run",
    "explore": "bun --no-env-file scripts/tasks.mjs explore",
    "test:coverage": "vitest run --coverage",
    "test:boot": "bun --bun playwright test tests/boot.spec.ts",
    "test:e2e": "bun --bun playwright test",
    "check:links": "bun --no-env-file scripts/links.mjs",
    "check:links:external": "bun --no-env-file scripts/links.mjs --external",
    "check:dependencies": "bun --no-env-file scripts/tasks.mjs dependencies",
    "check:advisories": "bun --no-env-file audit",
    "mutation": "bun --no-env-file scripts/tasks.mjs mutation"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.6.0",
    "@playwright/test": "1.65.1",
    "@puppeteer/browsers": "3.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.2",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.16.0",
    "fast-check": "4.11.0",
    "markdown-it": "15.0.3",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "parse5": "8.1.1",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "spdx-expression-parse": "5.0.0",
    "stylelint": "18.1.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "overrides": {
    "minimatch@10": "11.0.9",
    "typed-rest-client>qs": "6.17.1"
  }
}
